{
  "manifest_version": 3,
  "incognito": "not_allowed",
  "name": "Xboost",
  "version": "1.21.1",
  "description": "Find relevant X conversations with local scoring and optional Codex AI drafts. Review and send replies yourself.",
  "permissions": [
    "storage",
    "scripting",
    "clipboardWrite",
    "webRequest",
    "webRequestBlocking"
  ],
  "optional_host_permissions": ["ws://*/*", "wss://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws: wss:;"
  },
  "host_permissions": [
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*"
  ],
  "action": {
    "default_title": "Xboost",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "shared.js",
      "reply-context.js",
      "discovery.js",
      "queue-pagination.js",
      "job-repository.js",
      "codex-client.js",
      "ai-background.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "shared.js",
        "selection.js",
        "content.js",
        "assisted-reply.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "xboost@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "personalCommunications",
          "authenticationInfo",
          "browsingActivity",
          "searchTerms"
        ]
      }
    }
  }
}
